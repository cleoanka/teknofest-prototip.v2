# --- AURA .gitignore ---
# Model ağırlıkları (bootstrap tarafından indirilir)
weights/*.pt
weights/*.onnx
weights/*.engine
weights/*.metrics.json

# Eğitim koşum çıktıları (ultralytics train/val)
runs/

# Ham veri / büyük örnekler
data/raw/
data/processed/
data/processed_driver/
data/samples/*.mp4
data/samples/*.avi
eval_results/
output/
video_*.mp4
_run_on_video.py

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/

# Ortam / sırlar
.env

# Node / mobil
node_modules/
mobile/.expo/
mobile/dist/

# OS / editör
.DS_Store
.idea/
.vscode/
*.log
.server.pid

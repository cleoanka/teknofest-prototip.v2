# --- AURA .gitignore ---
# Model ağırlıkları (bootstrap tarafından indirilir)
weights/*.pt
weights/*.onnx
weights/*.engine
weights/*.metrics.json
# Eğitim çıktısı özel ağırlıklar (custom_*; uzantısız ara checkpoint kopyaları dahil — bootstrap/train üretir)
weights/custom_*
# weights/ altındaki model-olmayan ekler (araştırma PDF vb.)
weights/*.pdf
# İSTİSNA — 3 ÜRETİM custom modeli + held-out kanıt metrikleri repoya DAHİL (.pt → LFS, metrics → düz)
# custom_license_plate = varsayılan LP dedektörü; klonda `git lfs pull` ile gelir. _s.metrics.json = aynı modelin model.val çıktısı
!weights/custom_license_plate.pt
!weights/custom_smoking.pt
!weights/custom_seatbelt.pt
!weights/custom_license_plate_s.metrics.json
!weights/custom_smoking_s.metrics.json
!weights/custom_seatbelt_s.metrics.json

# Eğitim koşum çıktıları (ultralytics train/val)
runs/

# Ham veri / büyük örnekler
data/raw/
data/processed/
data/processed_driver/
data/samples/*.mp4
data/samples/*.avi
eval_results/
output/
video_*.mp4
_run_on_video.py

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/

# Ortam / sırlar
.env

# Node / mobil
node_modules/
mobile/.expo/
mobile/dist/

# OS / editör
.DS_Store
.idea/
.vscode/
*.log
.server.pid

# LaTeX derleme artefaktları (FTR PDF üretimi — kaynak .tex + çıktı .pdf tutulur)
*.aux
*.toc
*.out
*.fls
*.fdb_latexmk
*.synctex.gz

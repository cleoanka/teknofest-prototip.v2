# EditorConfig — https://editorconfig.org
# RoadGuard monorepo (Python çekirdek + JS dashboard + TS mobil + YAML config)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

# Python — black/ruff ile hizalı (4 boşluk, satır 100)
[*.py]
indent_size = 4
max_line_length = 100

# JS / TS / JSON / YAML — 2 boşluk yaygın standart
[*.{js,jsx,ts,tsx,json,yml,yaml}]
indent_size = 2

# Markdown — sondaki boşluk anlamlı olabilir (satır sonu <br>)
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# Makefile — TAB zorunlu
[Makefile]
indent_style = tab

# Windows script'leri CRLF ister
[*.ps1]
end_of_line = crlf

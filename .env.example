# RoadGuard ortam değişkenleri — `.env` olarak kopyalayın (bootstrap otomatik yapar).
# Gerçek sırları asla commit'lemeyin; .env .gitignore'da.

# AI çalışma modu (config.runtime.ai_mode'u override eder): real | mock | auto
AI_MODE=auto

# Torch backend override (boş → otomatik tespit): cpu | cuda | mps
ROADGUARD_DEVICE=

# Roboflow veri çekme (opsiyonel; yoksa local veriyle çalışır)
ROBOFLOW_API_KEY=

# CAMARA QoD gerçek backend (config.qod.backend=camara iken)
CAMARA_QOD_ENDPOINT=
CAMARA_QOD_TOKEN=

# Number Verification gerçek backend
NV_ENDPOINT=
NV_TOKEN=

# Servis portları (config/default.yaml ile aynı; override için)
ROADGUARD_INFERENCE_PORT=8080
ROADGUARD_QOD_MOCK_PORT=8081
ROADGUARD_NV_MOCK_PORT=8082

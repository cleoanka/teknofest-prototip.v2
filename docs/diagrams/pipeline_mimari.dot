// RoadGuard — FTR §3.2 kuşbakışı mimari (graphviz, YATAY/LR pipeline). Render:
//   dot -Tpng -Gdpi=220 docs/diagrams/pipeline_mimari.dot -o docs/figures/fig_mimari.png
digraph RoadGuard {
  rankdir=LR; bgcolor="white"; splines=spline; compound=true; pad=0.4;
  graph [fontname="Helvetica-Bold", fontsize=14, ranksep=0.6, nodesep=0.42];
  node  [fontname="Helvetica", fontsize=13, shape=box, style="rounded,filled",
         penwidth=1.8, margin="0.26,0.17", color="#1b5e20", fillcolor="#e8f5e9", height=0.7];
  edge  [fontname="Helvetica", fontsize=11, color="#455a64", penwidth=1.8, arrowsize=1.0];

  CAM [label="Kamera\nVideo · RTSP", fillcolor="#e3f2fd", color="#0d47a1"];
  PRE [label="Ön-İşleme\nROI CLAHE + gamma"];
  DET [label="AŞAMA 1\nYOLO26 + ByteTrack\nalan-ağırlıklı sınıf-oyu", fillcolor="#dcedc8", penwidth=2.6];

  subgraph cluster_s2 {
    label="AŞAMA 2 · paralel motorlar"; labelloc="t"; fontsize=13; fontcolor="#1b5e20";
    style="rounded,dashed"; color="#2e7d32"; bgcolor="#f4fbf4"; margin=16;
    DRV [label="Sürücü davranışı\npoz-hibrit + 16/8 oylama\n(landmark kütüphanesi YOK)", fillcolor="#fffde7", color="#f9a825"];
    PLT [label="Plaka okuma\nLP + fast-plate-ocr\noy havuzu · pozisyon-veto", fillcolor="#fffde7", color="#f9a825"];
    SPD [label="Hız + Swerving\nKalman + EMA · ZigZag", fillcolor="#fffde7", color="#f9a825"];
  }

  ACC  [label="ID-merkezli Birikim\nrisk kuralları", fillcolor="#dcedc8", color="#1b5e20", penwidth=2.6];
  OUT  [label="Olay / Annotation\nDashboard · Mobil · JSONL", fillcolor="#f3e5f5", color="#4a148c"];
  QOD  [label="5G QoD tetikleyici\nyaklaşma · kalite · anomali\n→ CAMARA Quality-on-Demand", fillcolor="#fff3e0", color="#e65100", penwidth=2.0];

  CAM -> PRE -> DET;
  DET -> DRV [lhead=cluster_s2, label="kabin\nROI"];
  DET -> PLT [label="plaka\nROI"];
  DET -> SPD;
  DRV -> ACC [ltail=cluster_s2];
  PLT -> ACC;
  SPD -> ACC;
  ACC -> OUT;

  PLT -> QOD [style=dashed, color="#e65100", penwidth=2.0, constraint=false];
  SPD -> QOD [style=dashed, color="#e65100", penwidth=2.0, constraint=false];
  QOD -> ACC [style=dashed, color="#e65100", penwidth=2.0, constraint=false, label="optimize"];
}

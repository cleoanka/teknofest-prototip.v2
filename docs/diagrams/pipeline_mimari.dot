// AURA — FTR §3.2 kuşbakışı mimari (graphviz). Render:
//   dot -Tpng -Gdpi=200 docs/diagrams/pipeline_mimari.dot -o docs/figures/fig_mimari.png
digraph AURA {
  rankdir=TB; bgcolor="white"; splines=spline; compound=true;
  graph [fontname="Helvetica", fontsize=12, ranksep=0.42, nodesep=0.40];
  node  [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled",
         penwidth=1.4, margin="0.16,0.09", color="#1b5e20", fillcolor="#e8f5e9"];
  edge  [fontname="Helvetica", fontsize=9, color="#37474f", penwidth=1.3, arrowsize=0.8];

  CAM [label="Kamera / Video / RTSP", fillcolor="#e3f2fd", color="#0d47a1"];
  PRE [label="Ön-İşleme\nfar-glare · blur · occlusion"];
  DET [label="YOLO26l + ByteTrack\n+ alan-ağırlıklı sınıf-oyu"];

  subgraph cluster_drv {
    label="Aşama 2a · Sürücü ROI"; labeljust="l"; fontsize=11; fontcolor="#1b5e20";
    style="rounded,dashed"; color="#1b5e20"; bgcolor="#f4fbf5";
    LA [label="Katman A: pose-hibrit / YOLO26\n(landmark kütüphanesi YOK)"];
    LB [label="Katman B: per-ID 16/8\nzaman-oylaması"];
    LA -> LB;
  }
  subgraph cluster_plt {
    label="Aşama 2b · Plaka ROI (konsensüs)"; labeljust="l"; fontsize=11; fontcolor="#1b5e20";
    style="rounded,dashed"; color="#1b5e20"; bgcolor="#f4fbf5";
    LP  [label="custom YOLO26s LP\n(sıkı kırpma)"];
    OCR [label="oy havuzu + fast-plate-ocr\n+ pozisyon-veto / zemin koşulu"];
    LP -> OCR;
  }

  SPD  [label="Hız + Swerving\nKalman+EMA · ZigZag"];
  ACC  [label="ID-merkezli Accumulator + risk kuralları"];
  OUT  [label="Event / Annotation akışı", fillcolor="#f3e5f5", color="#4a148c"];
  SINK [label="Dashboard   ·   Mobil   ·   JSONL kanıt", fillcolor="#f3e5f5", color="#4a148c"];
  QOD  [label="QoD tetik\nyaklaşma / kalite / anomali\n→ CAMARA QoD (5G)", fillcolor="#fff3e0", color="#e65100"];

  CAM -> PRE -> DET;
  DET -> LA  [lhead=cluster_drv, label="kabin ROI"];
  DET -> LP  [lhead=cluster_plt, label="plaka ROI"];
  DET -> SPD;
  LB  -> ACC [ltail=cluster_drv];
  OCR -> ACC [ltail=cluster_plt];
  SPD -> ACC;
  ACC -> OUT -> SINK;

  SPD -> QOD [style=dashed, color="#e65100", constraint=false];
  OCR -> QOD [style=dashed, color="#e65100", ltail=cluster_plt, constraint=false];
  QOD -> ACC [style=dashed, color="#e65100", constraint=false, label="optimize"];

  { rank=same; SPD; QOD; }
}
